{
  "name": "print-agent",
  "version": "1.0.0",
  "description": "Print agent with Electron setup UI",
  "author": "",
  "license": "ISC",
  "type": "module",
  "main": "src/electron/main.js",

  "scripts": {
    "start": "node src/index.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "build-win": "electron-builder --win --x64"
  },

  "dependencies": {
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "node-printer": "^1.0.4"
  },

  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.15.0"
  },

  "build": {
    "appId": "com.printinnovx.agent",
    "productName": "PrintInnovX Agent",

    "directories": {
      "output": "dist"
    },

    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],

    "win": {
      "icon": "./assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintInnovX Agent",
      "installerIcon": "./assets/icon.ico",
      "uninstallerIcon": "./assets/icon.ico",
      "installerHeaderIcon": "./assets/icon.ico"
    }
  }
}